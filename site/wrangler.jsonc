{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grovelandconcrete",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-07",
  "services": [
    { "binding": "CONTACT_EMAIL", "service": "grovelandconcrete-contact" }
